# Variables du frontend transmises par Docker Compose.
NUXT_PUBLIC_CONTACT_EMAIL=na.labrazi@gmail.com
# Clé d'accès publique Web3Forms associée à l'adresse destinataire.
NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# La compilation Android utilise par défaut cette API publique (HTTPS obligatoire).
# Pour le web local, ne renseigner cette variable que si nécessaire.
# NUXT_PUBLIC_API_BASE_URL=https://api.sawt-ai.nabster.dev
# Par défaut, le lien Android utilise l'APK bêta publié sur sawt-ai.nabster.dev.
# Décommenter pour servir un APK signé depuis ce serveur.
# NUXT_PUBLIC_ANDROID_DOWNLOAD_URL=/downloads/sawt-ai-android.apk
