{
  "name": "sawt-ai",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "biome format . --write",
    "format:check": "biome check . --formatter-enabled=true --linter-enabled=false --assist-enabled=false --max-diagnostics=none",
    "generate": "nuxt generate",
    "generate:android": "node scripts/generate-android.mjs",
    "android:sync": "npm run generate:android && cap sync android",
    "android:open": "cap open android",
    "android:keygen": "node scripts/init-android-signing.mjs",
    "android:debug": "node scripts/build-android.mjs debug",
    "android:release": "node scripts/build-android.mjs release",
    "android:bundle": "node scripts/build-android.mjs bundle",
    "android:publish": "npm run android:release && node scripts/prepare-android-download.mjs",
    "lint": "biome lint . --max-diagnostics=none --error-on-warnings",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/prepare-types.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@lucide/vue": "^1.24.0",
    "@vueuse/core": "^14.4.0",
    "motion-v": "^2.5.1",
    "nuxt": "^4.5.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@capacitor/cli": "^8.5.3",
    "@nuxt/kit": "^4.6.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.9",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "motion-v": {
      "framer-motion": "13.3.0",
      "motion-dom": "13.3.0",
      "motion-utils": "13.3.0"
    }
  }
}
