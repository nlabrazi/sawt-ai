{
  "name": "sawt-ai",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/prepare-types.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "generate:android": "node scripts/generate-android.mjs",
    "android:sync": "npm run generate:android && cap sync android",
    "android:open": "cap open android",
    "android:keygen": "node scripts/init-android-signing.mjs",
    "android:debug": "node scripts/build-android.mjs debug",
    "android:release": "node scripts/build-android.mjs release",
    "android:bundle": "node scripts/build-android.mjs bundle",
    "android:publish": "npm run android:release && node scripts/prepare-android-download.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@lucide/vue": "^1.24.0",
    "@vueuse/core": "^14.4.0",
    "motion-v": "^2.5.1",
    "nuxt": "^4.5.2",
    "vue": "^3.5.44",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@nlabrazi/config-biome": "^0.2.0",
    "@nlabrazi/config-playwright": "^0.1.0",
    "@nlabrazi/config-vitest": "^0.1.0",
    "@nlabrazi/tsconfig": "^0.1.0",
    "@nuxt/kit": "^4.6.1"
  }
}
