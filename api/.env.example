# Separate each allowed frontend origin explicitly.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WHISPER_MODEL_NAME=base
QURAN_VERSETS_PATH=/app/assets/quran_versets.json
# Optional local tajwid snapshot. If empty, the API fetches the corpus once
# from the configured backup URL or AlQuran Cloud, then keeps it in memory.
TAJWID_DATA_PATH=
# Optional public backup URL, e.g. a JSON file hosted in Supabase Storage.
TAJWID_BACKUP_URL=
IMAM_MODEL_PATH=/training/artifacts/models/imam_ecapa_v2/best_model.pt

# Supabase feedback storage.
# Use the Project URL from the dashboard "Connect" dialog.
# Do not put the Postgres connection string here.
SUPABASE_URL=

# Server-side key only:
# - accepted: service_role or sb_secret
# - rejected: anon or sb_publishable
SUPABASE_API_KEY=

SUPABASE_FEEDBACK_TABLE=feedbacks
